# AutoCart Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api

# AutoCart Multi-Agent AI (Backend only - never expose in client bundles)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# Optional: real email through a free Gmail account (use an app password). Without these, emails print in the server console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: where the OCR engine finds Tesseract is NOT needed; document reading uses the pip package rapidocr-onnxruntime.

# Optional: Razorpay TEST keys only (rzp_test_...). Live keys are refused by the app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
